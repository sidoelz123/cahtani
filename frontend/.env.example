# Backend API Server URL (HonoJS)
# Kosongkan atau samakan jika menggunakan Vite proxy / Same-Origin
VITE_API_BASE_URL="http://localhost:5000"

# GEMINI_API_KEY (Jika digunakan di level client/env)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
